@page "{id:guid}"
@model Cicci.SampleManager.Pages.DeviceDetailsModel
@using Cicci.SampleManager.Models
@using System.Text.Json

@{
  ViewData["Title"] = $"{Model.Device.Sample.Batch.Code} - {Model.Device.Sample.Code} - {Model.Device.Pixel}";
  var selected = Model.SelectedMeasurement;
}

<div class="sample-page">
  <div class="details-header">
    <div>
      <a asp-page="/SampleDetails" asp-route-id="@Model.Device.Sample.Id" class="details-back">
        ← Back to @Model.Device.Sample.Code
      </a>
      <div class="eyebrow">
        @Model.Device.Sample.Batch.Code · @Model.Device.Sample.Code
      </div>
      <h1>Pixel @Model.Device.Pixel</h1>
      <div class="details-back"> @Model.Device.Id </div>
      <p>@Model.TotalMeasurementCount measurement(s)</p>
    </div>
  </div>

  @if (!string.IsNullOrWhiteSpace(Model.Device.Notes))
  {
    <div class="device-details-note">@Model.Device.Notes</div>
  }

  @if (Model.LatestMeasurements.Count > 0)
  {
    <div class="details-section">
      <div class="details-section-header">
        <div>
          <h2>Latest results</h2>
          <p>Newest measurement of each available type.</p>
        </div>
      </div>

      <div class="latest-measurement-grid">
        @foreach (var measurement in Model.LatestMeasurements)
        {
          <a asp-page="/DeviceDetails"
            asp-route-id="@Model.Device.Id"
            asp-route-type="@measurement.Type"
            asp-route-page="1"
            asp-route-measurementId="@measurement.Id"
            class="latest-measurement-card">

            <div class="latest-measurement-header">
              <span class="measurement-type">
                @measurement.Type
              </span>

              <span>
                @measurement.MeasuredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
              </span>
            </div>

            <strong>
              @Model.GetMeasurementHighlight(measurement)
            </strong>
          </a>
        }
      </div>
    </div>
  }

  <div class="details-section">
    <div class="details-section-header">
      <div>
        <h2>Measurement history</h2>
        <p>Select a measurement to view its complete results.</p>
      </div>
    </div>

    <div class="measurement-filters">
      <a asp-page="/DeviceDetails"
        asp-route-id="@Model.Device.Id"
        class="measurement-filter @(Model.SelectedType == null ? "selected" : "")">
        All
        <span>@Model.TotalMeasurementCount</span>
      </a>

      @foreach (var typeCount in Model.MeasurementTypeCounts)
      {
        <a asp-page="/DeviceDetails"
          asp-route-id="@Model.Device.Id"
          asp-route-type="@typeCount.Type"
          class="measurement-filter @(Model.SelectedType == typeCount.Type ? "selected" : "")">
          @typeCount.Type
          <span>@typeCount.Count</span>
        </a>
      }
    </div>

    @if (Model.FilteredMeasurementCount == 0)
    {
      <div class="measurement-empty">
        @if (Model.TotalMeasurementCount == 0)
        {
          <span>No measurements have been recorded for this pixel yet.</span>
        }
        else
        {
          <span>No @Model.SelectedType measurements have been recorded for this pixel.</span>
        }
      </div>
    }
    else
    {
      <div class="measurement-history">
        @foreach (var measurement in Model.Measurements)
        {
          var isSelected = selected?.Id == measurement.Id;

          <div class="measurement-history-row @(isSelected ? "selected" : "")">
            <a asp-page="/DeviceDetails"
              asp-route-id="@Model.Device.Id"
              asp-route-type="@Model.SelectedType"
              asp-route-historyPage="@Model.CurrentPage"
              asp-route-measurementId="@measurement.Id"
              class="measurement-history-link">

              <div class="measurement-history-time">
                <strong>@measurement.MeasuredAt.ToLocalTime().ToString("dd/MM/yyyy")</strong>
                <span>@measurement.MeasuredAt.ToLocalTime().ToString("HH:mm:ss")</span>
              </div>

              <span class="measurement-type">
                @measurement.Type
              </span>

              <strong class="measurement-highlight">
                @Model.GetMeasurementHighlight(measurement)
              </strong>

              <span class="measurement-open">›</span>
            </a>

            <form method="post"
                  asp-page-handler="DeleteMeasurement"
                  asp-route-id="@Model.Device.Id"
                  asp-route-type="@Model.SelectedType"
                  asp-route-historyPage="@Model.CurrentPage"
                  class="measurement-delete-form"
                  onsubmit="return confirm('Permanently delete this measurement from the Sample Manager database?');">

              <input type="hidden"
                    name="measurementId"
                    value="@measurement.Id" />

              <button type="submit"
                      class="measurement-delete-button"
                      title="Delete measurement">
                Delete
              </button>
            </form>
          </div>
        }
      </div>

      @if (Model.FilteredMeasurementCount > 0)
      {
        var firstMeasurement =
            ((Model.CurrentPage - 1) * Model.PageSize) + 1;

        var lastMeasurement =
            Math.Min(
                Model.CurrentPage * Model.PageSize,
                Model.FilteredMeasurementCount);

        <div class="measurement-pagination">
          <div class="measurement-pagination-info">
            Showing @firstMeasurement–@lastMeasurement
            of @Model.FilteredMeasurementCount
          </div>

          <div class="measurement-pagination-controls">
            @if (Model.CurrentPage > 1)
            {
              <a asp-page="/DeviceDetails"
                asp-route-id="@Model.Device.Id"
                asp-route-type="@Model.SelectedType"
                asp-route-historyPage="@(Model.CurrentPage - 1)"
                class="measurement-page-button">
                ← Previous
              </a>
            }
            else
            {
              <span class="measurement-page-button disabled">
                ← Previous
              </span>
            }

            <span class="measurement-page-current">
              Page @Model.CurrentPage of @Model.PageCount
            </span>

            @if (Model.CurrentPage < Model.PageCount)
            {
              <a asp-page="/DeviceDetails"
                asp-route-id="@Model.Device.Id"
                asp-route-type="@Model.SelectedType"
                asp-route-historyPage="@(Model.CurrentPage + 1)"
                class="measurement-page-button">
                Next →
              </a>
            }
            else
            {
              <span class="measurement-page-button disabled">
                Next →
              </span>
            }
          </div>
        </div>
      }
    }
  </div>

  @if (selected != null)
  {
    <div class="measurement-detail-grid">
      <div class="measurement-detail-card">
        <div class="measurement-card-header">
          <div>
            <div class="eyebrow">COMMON</div>
            <h2>Measurement</h2>
          </div>
          <span class="measurement-type">
            @selected.Type
          </span>
        </div>

        <div class="measurement-common-list">
          <div class="measurement-common-row">
            <span>Measured</span>
            <strong>
              @selected.MeasuredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
            </strong>
          </div>

          <div class="measurement-common-row">
          <span>Data file</span>
          @if (!string.IsNullOrWhiteSpace(selected.DataPath))
          {
              <div class="measurement-data-file">
              <code class="measurement-path"
                      title="@selected.DataPath">@selected.DataPath</code>
              <a asp-page="/DeviceDetails"
                  asp-page-handler="DataFile"
                  asp-route-id="@Model.Device.Id"
                  asp-route-measurementId="@selected.Id"
                  target="_blank"
                  rel="noopener"
                  class="measurement-file-button">
                  Open ↗
              </a>
              </div>
          }
          else
          {
              <strong>—</strong>
          }
          </div>

          <div class="measurement-common-row">
            <span>Notes</span>
            @if (!string.IsNullOrWhiteSpace(selected.Notes))
            {
              <div class="measurement-notes">@selected.Notes</div>
            }
            else
            {
              <strong>—</strong>
            }
          </div>
        </div>
      </div>

      <div class="measurement-detail-card">
        @if (selected.Type == MeasurementType.JV && selected.Jv != null)
        {
          <div class="measurement-card-header">
            <div>
              <div class="eyebrow">SPECIFIC</div>
              <h2>JV results</h2>
            </div>
          </div>

          <div class="measurement-primary-results">
            <div class="measurement-result">
              <strong>
                @Model.FormatValue(
                  selected.Jv.EfficiencyPercent,
                  "%")
              </strong>
              <span>Efficiency</span>
            </div>
            <div class="measurement-result">
              <strong>
                @Model.FormatValue(
                  selected.Jv.VocV,
                  "V",
                  "0.###")
              </strong>
              <span>Voc</span>
            </div>
            <div class="measurement-result">
              <strong>
                @Model.FormatValue(
                  selected.Jv.JscMilliampPerCm2,
                  "mA/cm²")
              </strong>
              <span>Jsc</span>
            </div>
            <div class="measurement-result">
              <strong>
                @Model.FormatValue(
                  selected.Jv.FillFactorPercent,
                  "%")
              </strong>
              <span>Fill factor</span>
            </div>
          </div>

          <div class="measurement-secondary-results">
            <div class="measurement-result secondary">
              <strong>
                @Model.FormatValue(
                  selected.Jv.VmppV,
                  "V",
                  "0.###")
              </strong>
              <span>Vmpp</span>
            </div>
            <div class="measurement-result secondary">
              <strong>
                @Model.FormatValue(
                  selected.Jv.JmppMilliampPerCm2,
                  "mA/cm²")
              </strong>
              <span>Jmpp</span>
            </div>
            <div class="measurement-result secondary">
              <strong>
                @Model.FormatValue(
                  selected.Jv.PmppMilliwattPerCm2,
                  "mW/cm²")
              </strong>
              <span>Pmpp</span>
            </div>
          </div>
        }
        else if (selected.Type == MeasurementType.EQE && selected.Eqe != null)
        {
          <div class="measurement-card-header">
            <div>
              <div class="eyebrow">SPECIFIC</div>
              <h2>EQE results</h2>
            </div>
          </div>

          <div class="measurement-primary-results">
            <div class="measurement-result">
              <strong>
                @Model.FormatValue(
                  selected.Eqe.Jsc,
                  "mA/cm²")
              </strong>
              <span>Integrated Jsc</span>
            </div>
            <div class="measurement-result">
              <strong>
                @Model.FormatValue(
                  selected.Eqe.PeakEQE,
                  "%")
              </strong>
              <span>Peak EQE</span>
            </div>
          </div>
        }
        else
        {
          <div class="measurement-card-header">
            <div>
              <div class="eyebrow">SPECIFIC</div>
              <h2>@selected.Type results</h2>
            </div>
          </div>
          <div class="measurement-empty">
            No specific results are available for this measurement.
          </div>
        }
      </div>
    </div>

    @if (selected.Type == MeasurementType.JV && Model.JvPlot != null)
    {
      <div class="measurement-plot-card">
        <div class="measurement-card-header">
          <div>
            <div class="eyebrow">RAW DATA</div>
            <h2>JV curve</h2>
          </div>
        </div>

        @if (Model.JvPlot.HasData)
        {
          <div class="jv-chart-container">
            <canvas id="jvChart"></canvas>
          </div>
        }
        else
        {
          <div class="measurement-empty">
            Plot unavailable.
            @if (!string.IsNullOrWhiteSpace(Model.JvPlot.Error))
            {
              <span>@Model.JvPlot.Error</span>
            }
          </div>
        }
      </div>
    }
  }
</div>

@section Scripts {
  @if (Model.JvPlot?.HasData == true)
  {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

    <script>
      (() => {
        const plot = @Html.Raw(
          JsonSerializer.Serialize(
            Model.JvPlot,
            new JsonSerializerOptions
            {
              PropertyNamingPolicy = JsonNamingPolicy.CamelCase
            }
          )
        );

        const datasets = [];

        if (plot.forward.length > 0) {
          datasets.push({
            label: "Forward",
            data: plot.forward,
            showLine: true,
            pointRadius: 0,
            pointHoverRadius: 4,
            borderWidth: 2,
            borderColor: "#2563eb",
            backgroundColor: "#2563eb"
          });
        }

        if (plot.reverse.length > 0) {
          datasets.push({
            label: "Reverse",
            data: plot.reverse,
            showLine: true,
            pointRadius: 0,
            pointHoverRadius: 4,
            borderWidth: 2,
            borderColor: "#dc2626",
            backgroundColor: "#dc2626"
          });
        }

        const canvas = document.getElementById("jvChart");

        if (!canvas)
          return;

        new Chart(canvas, {
          type: "scatter",

          data: {
            datasets
          },

          options: {
            responsive: true,
            maintainAspectRatio: false,

            animation: false,

            interaction: {
              mode: "nearest",
              intersect: false
            },

            scales: {
              x: {
                type: "linear",
                title: {
                  display: true,
                  text: "Voltage (V)"
                }
              },

              y: {
                title: {
                  display: true,
                  text: "Current density (mA/cm²)"
                }
              }
            },

            plugins: {
              legend: {
                display: datasets.length > 1
              },

              tooltip: {
                callbacks: {
                  label(context) {
                    const point = context.raw;

                    return `${context.dataset.label}: ${point.x.toFixed(4)} V, ${point.y.toFixed(3)} mA/cm²`;
                  }
                }
              }
            }
          }
        });
      })();
    </script>
  }
}