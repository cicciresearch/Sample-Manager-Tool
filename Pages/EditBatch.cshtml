@page "{id:guid}"
@model Cicci.SampleManager.Pages.EditBatchModel

@{
    ViewData["Title"] = "Edit Batch";
}

<div class="sample-page">
    <div class="form-header">
        <div class="eyebrow">CICCI RESEARCH</div>
        <h1>Edit Batch</h1>
        <p>Update information shared by all samples and devices in this batch.</p>
    </div>

    <form method="post" class="sample-form">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-message"></div>

        <div class="form-section">
            <h2>Batch</h2>
            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="UserId">User</label>
                    <select asp-for="UserId">
                        <option value="">Select user...</option>
                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.Id">@user.Name</option>
                        }
                    </select>
                    <span asp-validation-for="UserId" class="validation-message"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Area">Area (cm²)</label>
                    <input asp-for="Area" type="number" step="any" min="0" />
                    <span asp-validation-for="Area" class="validation-message"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Code">Batch code</label>
                    <input asp-for="Code" />
                    <span asp-validation-for="Code" class="validation-message"></span>
                </div>

                <div class="form-field">
                    <label asp-for="ProductionDate">Production date</label>
                    <input asp-for="ProductionDate" type="date" />
                </div>
            </div>
        </div>

        <div class="form-section">
            <h2>Device stack <span class="optional-label">Optional</span></h2>
            <div class="form-field">
                <label asp-for="StackLayers">Layers</label>
                <textarea asp-for="StackLayers" rows="7"
                          placeholder="Glass&#10;ITO&#10;SnO2&#10;Perovskite&#10;Spiro-OMeTAD&#10;Au"></textarea>
                <p class="form-help">Enter one layer per line, from bottom/substrate to top.</p>
            </div>
        </div>

        <div class="form-section">
            <h2>Notes <span class="optional-label">Optional</span></h2>
            <div class="form-field">
                <label asp-for="Notes">Batch notes</label>
                <textarea asp-for="Notes" rows="4"
                          placeholder="Optional notes about this production batch..."></textarea>
            </div>
        </div>

        <div class="form-actions">
            <a asp-page="/Index" asp-route-userId="@Model.UserId" class="cancel-button">Cancel</a>
            <button type="submit" class="save-button">Save Changes</button>
        </div>
    </form>
</div>